experiment_id: benchmark_full_template

paths:
  benchmark_inputs_dir: benchmark_inputs
  benchmark_clusters_csv: benchmark_inputs/benchmark_clusters.csv
  evidence_bundles_dir: benchmark_evidence_bundles_uniprot
  output_dir: benchmarking_outputs/template
  bundle_source: uniprot

model:
  provider: anthropic
  model_name: claude-sonnet-4-5
  temperature: 0.2
  max_tokens: 4000
  top_p: null
  top_k: null

run:
  num_replicates: 3
  max_workers: 4
  dry_run: false
  workflow_testing: false
  overwrite_outputs: false
  continue_on_error: true
  save_prompts: true
  save_raw_outputs: true
  save_parsed_outputs: true
  save_traces: true

architecture_benchmark:
  enabled: false
  base_routes:
    - 3a
    - 3a_mcp
    - 3b
    - 3b_mcp
    - 3c
    - 3c_mcp

order_benchmark:
  enabled: false
  base_routes:
    - 3a
    - 3a_mcp
    - 3b
    - 3b_mcp
    - 3c
    - 3c_mcp
  variants:
    - O
    - O1
    - O2
    - O3
    - O4

wording_benchmark:
  enabled: false
  base_routes:
    - 3a
    - 3a_mcp
    - 3b
    - 3b_mcp
    - 3c
    - 3c_mcp
  targets:
    - W0
    - W1
    - W2
    - W3
    - W4
    - W5
  default_source: null
  force_source: null

screens:
  include: all

clusters:
  include: all

mcp:
  preflight: true
  fail_if_unavailable: false

evaluation:
  structural: true
  logical_consistency: true
  efficiency: true
  robustness: true

timing:
  track_full_run: true
  track_prompt_construction: true
  track_model_latency: true
  track_metrics: true
  track_io: true
  track_step_latencies: true
  track_mcp_tool_latency: true
